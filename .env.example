DATABASE_URL=
DIRECT_URL=
SHADOW_DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@pantri.app
ADMIN_PASSWORD=Admin123!
PORT=3000

# ImageKit (required for package cover uploads)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Public share links base (no trailing slash), e.g. https://pantri.app
APP_SHARE_BASE_URL=https://pantri.app

# OpenAI / Anthropic (optional  meal plans fall back to catalog heuristics when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_DEFAULT_PROVIDER=auto
