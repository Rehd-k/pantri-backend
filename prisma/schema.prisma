// Pantri  payroll-backed revolving credit platform
// Money: integer kobo only. Ledger is source of truth.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity enums ───────────────────────────────────────────

enum UserRole {
  ADMIN
  EMPLOYER
  EMPLOYEE
  SUPPLIER
  LOGISTICS
  NUTRITIONIST
}

enum UserStatus {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED
}

enum PlatformRole {
  SUPER_ADMIN
  FINANCE_OFFICER
  AUDITOR
  NUTRITIONIST
}

enum EmployerMembershipRole {
  EMPLOYER_ADMIN
  PAYROLL_OFFICER
  FINANCE_OFFICER
  CREDIT_OFFICER
  AUDITOR
}

enum EmployeeAccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum EmployeeVerificationStatus {
  INVITED
  REGISTERED
  DOCS_SUBMITTED
  APPROVED
  REJECTED
}

enum EmployeeInviteStatus {
  PENDING
  USED
  REVOKED
  EXPIRED
}

enum VerificationDocumentType {
  EMPLOYMENT_PROOF
  PAYROLL_PROOF
  OTHER
}

enum VerificationDocumentStatus {
  UPLOADED
  SUBMITTED
  REJECTED
}

enum CompanyInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum PayrollFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
}

// ─── Credit / ledger enums ────────────────────────────────────

enum CreditAccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum OverLimitAction {
  REJECT
  REQUIRE_APPROVAL
}

enum OverDurationAction {
  REJECT
  REQUIRE_APPROVAL
  SUGGEST_WAIT
  ALLOW_HIGHER_DEDUCTION
}

enum LedgerEntryType {
  RESERVATION_CREATED
  RESERVATION_RELEASED
  PURCHASE_POSTED
  DELIVERY_FEE
  SERVICE_FEE
  INTEREST
  PENALTY
  PAYROLL_REPAYMENT
  REFUND
  ADJUSTMENT
  CREDIT_LIMIT_ADJUSTMENT
  WRITE_OFF
  MANUAL_CREDIT
  MANUAL_DEBIT
  MIGRATION
}

enum ProductType {
  FOOD
  ELECTRONICS
  RENT
  SCHOOL_FEES
  HEALTH
  OTHER
}

enum CreditReservationStatus {
  ACTIVE
  PARTIALLY_CAPTURED
  CAPTURED
  RELEASED
  EXPIRED
}

enum WriteOffStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
}

// ─── Order enums (dual state machines) ────────────────────────

enum OrderFulfillmentStatus {
  DRAFT
  /// Order placed before employee verification; no credit reserved.
  VERIFICATION_HOLD
  PENDING_APPROVAL
  APPROVED
  /// Product language: sourcing
  PROCESSING
  /// Product language: waiting for pickup
  READY_FOR_PICKUP
  /// Product language: in transit
  OUT_FOR_DELIVERY
  /// Product language: delivered
  FULFILLED
  CANCELLED
  EXPIRED
}

enum OrderCreditStatus {
  NONE
  RESERVED
  PARTIALLY_CAPTURED
  CAPTURED
  PARTIALLY_RELEASED
  RELEASED
  PARTIALLY_REFUNDED
  REFUNDED
}

// Legacy installment enums (read-only after migration)
enum DeductionStatus {
  ACTIVE
  REPAID
  DEFAULTED
  SUSPENDED
}

enum InstallmentStatus {
  SCHEDULED
  COLLECTED
  SKIPPED
}

// ─── Payroll enums ────────────────────────────────────────────

enum PayrollRunStatus {
  DRAFT
  GENERATED
  EMPLOYER_REVIEW
  CONFIRMED
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED
}

enum PayrollDeductionLineStatus {
  PENDING
  MISSED
  REMITTED
  REVERSED
}

// ─── Risk / notify / outbox ───────────────────────────────────

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

// ─── Marketplace enums (unchanged) ────────────────────────────

enum PackageKind {
  CURATED
  COMMUNITY
  AI_GENERATED
}

enum MeasureDimension {
  MASS
  VOLUME
  COUNT
}

enum MeasureKind {
  METRIC
  PANTRA
  TRADITIONAL
  COUNT
}

// ─── Nutrition / meal-plan enums ──────────────────────────────

enum DietaryLifestyle {
  EVERYTHING
  VEGAN
  VEGETARIAN
  KETO
  MIXED
}

enum ActivityLevel {
  SEDENTARY
  MODERATE
  VERY_ACTIVE
}

enum MealPlanStatus {
  DRAFT
  GENERATING
  PENDING_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum MealPlanSource {
  MANUAL
  AI
  HYBRID
}

enum MealItemMatchType {
  PRIMARY
  ALTERNATIVE
}

enum HouseholdStockLedgerReason {
  ORDER_FULFILLED
  MANUAL_ADD
  MANUAL_ADJUST
  COOKED
  RESTOCK_DISCARDED
}

enum RestockAlertStatus {
  OPEN
  DISMISSED
  ADDED_TO_CART
}

enum RecipeSource {
  AI
  USER
  NUTRITIONIST
}

enum PackageVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum PackageSubscriptionStatus {
  PENDING
  CANCELLED
}

enum BlogPostCategory {
  FOOD
  NUTRITION
  RECIPES
  FAMILY
  BUDGETING
  HEALTHY_LIVING
  FOOD_PRICES
  COOKING
  EVENTS
  VIDEOS
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ═══════════════════════════════════════════════════════════════
// IDENTITY & TENANCY
// ═══════════════════════════════════════════════════════════════

model Employer {
  id                String           @id @default(cuid())
  name              String
  inviteCode        String           @unique
  payrollDayOfMonth Int              @default(15)
  payrollFrequency  PayrollFrequency @default(MONTHLY)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  memberships   EmployerMembership[]
  employees     Employee[]
  employeeInvites EmployeeInvite[]
  creditPolicy  CreditPolicy?
  pickupPoints  EmployerPickupPoint[]
  orders        Order[]
  payrollRuns   PayrollRun[]
  invoices      CompanyInvoice[]
  users         User[]

  @@map("Employer")
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           UserRole
  status         UserStatus    @default(ACTIVE)
  platformRole   PlatformRole?
  /// Soft link for employer-role users during transition; prefer EmployerMembership.
  employerId     String?
  employer       Employer?     @relation(fields: [employerId], references: [id])
  businessName   String?
  fleetName      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  employee               Employee?
  memberships            EmployerMembership[]
  cart                   Cart?
  productReviews         ProductReview[]
  reviewHelpfulVotes     ProductReviewHelpful[]
  wishlistItems          WishlistItem[]
  packages               PantryPackage[]
  packageSubscriptions   PackageSubscription[]
  auditLogs              AuditLog[]            @relation("AuditActor")
  ledgerEntriesCreated   LedgerEntry[]         @relation("LedgerCreatedBy")
  notifications          Notification[]
  idempotencyRecords     IdempotencyRecord[]
  writeOffsRequested     WriteOffRequest[]     @relation("WriteOffRequester")
  writeOffsApproved      WriteOffRequest[]     @relation("WriteOffApprover")
  mealPlansReviewed      MealPlan[]            @relation("MealPlanReviewer")
  mealPlansCreated       MealPlan[]            @relation("MealPlanCreator")
  invitesCreated         EmployeeInvite[]      @relation("InviteCreator")
  verificationDocsUploaded VerificationDocument[] @relation("VerificationUploader")
  employeesVerified      Employee[]            @relation("EmployeeVerifier")
  orderStatusChanges     OrderStatusHistory[]  @relation("OrderStatusActor")
  invoicesGenerated      CompanyInvoice[]      @relation("InvoiceGenerator")
  blogPostsAuthored      BlogPost[]            @relation("BlogPostAuthor")

  @@index([employerId])
  @@index([role, status])
}

model EmployerMembership {
  id         String                 @id @default(cuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerId String
  employer   Employer               @relation(fields: [employerId], references: [id], onDelete: Cascade)
  role       EmployerMembershipRole
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@unique([userId, employerId, role])
  @@index([employerId, role])
  @@index([userId])
}

model Employee {
  id                  String                     @id @default(cuid())
  userId              String                     @unique
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerId          String
  employer            Employer                   @relation(fields: [employerId], references: [id])
  salaryKobo          Int                        @default(0)
  /// Per-employee override; null falls back to employer CreditPolicy.creditMultiplierBps.
  creditMultiplierBps Int?
  deductionPercent    Int                        @default(20)
  employmentStartedAt DateTime                   @default(now())
  accountStatus       EmployeeAccountStatus      @default(ACTIVE)
  verificationStatus  EmployeeVerificationStatus @default(REGISTERED)
  verifiedAt          DateTime?
  verifiedById        String?
  verifiedBy          User?                      @relation("EmployeeVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectionReason     String?
  phone               String?
  addressLine         String?
  city                String?
  state               String?
  latitude            Float?
  longitude           Float?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  creditAccount       CreditAccount?
  riskProfile         RiskProfile?
  salaryHistory       SalaryHistory[]
  orders              Order[]
  payrollLines        PayrollDeductionLine[]
  healthProfile       HealthProfile?
  mealPlans           MealPlan[]
  householdStock      HouseholdStock[]
  restockAlerts       RestockAlert[]
  recipes             Recipe[]
  cookedMeals         CookedMeal[]
  dailyNutritionLogs  DailyNutritionLog[]
  invite              EmployeeInvite?
  verificationDocuments VerificationDocument[]
  invoiceLines        CompanyInvoiceLine[]

  @@index([employerId])
  @@index([employerId, accountStatus])
  @@index([employerId, verificationStatus])
  @@index([userId, employerId])
  @@index([verificationStatus, createdAt])
}

model EmployeeInvite {
  id           String              @id @default(cuid())
  employerId   String
  employer     Employer            @relation(fields: [employerId], references: [id], onDelete: Cascade)
  code         String              @unique
  email        String
  phone        String?
  status       EmployeeInviteStatus @default(PENDING)
  expiresAt    DateTime
  usedAt       DateTime?
  usedByUserId String?
  employeeId   String?             @unique
  employee     Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?               @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([employerId, status])
  @@index([email, status])
  @@index([expiresAt])
}

model VerificationDocument {
  id           String                      @id @default(cuid())
  employeeId   String
  employee     Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         VerificationDocumentType
  status       VerificationDocumentStatus  @default(UPLOADED)
  fileName     String
  fileUrl      String
  imageKitFileId String?
  mimeType     String?
  uploadedById String
  uploadedBy   User                        @relation("VerificationUploader", fields: [uploadedById], references: [id])
  note         String?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@index([employeeId, type])
  @@index([employeeId, status])
}

model SalaryHistory {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryKobo Int
  effectiveAt DateTime @default(now())
  reason     String?
  createdAt  DateTime @default(now())

  @@index([employeeId, effectiveAt])
}

model EmployerPickupPoint {
  id          String   @id @default(cuid())
  employerId  String
  employer    Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  label       String
  addressLine String
  city        String
  state       String?
  latitude    Float
  longitude   Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@index([employerId, isActive])
}

// ═══════════════════════════════════════════════════════════════
// CREDIT ENGINE
// ═══════════════════════════════════════════════════════════════

model CreditPolicy {
  id                              String             @id @default(cuid())
  employerId                      String             @unique
  employer                        Employer           @relation(fields: [employerId], references: [id], onDelete: Cascade)
  version                         Int                @default(1)
  defaultDeductionPercent         Int                @default(20)
  minDeductionPercent             Int                @default(10)
  maxDeductionPercent             Int                @default(35)
  employeeMaySetDeductionPercent  Boolean            @default(true)
  creditMultiplierBps             Int                @default(15000) // 1.5x = 15000 bps of 10000
  maxRepaymentMonths              Int                @default(6)
  reservationTtlHours             Int                @default(72)
  approvalTtlHours                Int                @default(72)
  interestAnnualRateBps           Int                @default(1800) // 18%
  interestGraceDays               Int                @default(30)
  penaltiesEnabled                Boolean            @default(false)
  minDaysBetweenPurchases         Int                @default(14)
  maxPurchasesInWindow            Int                @default(2)
  purchaseWindowDays              Int                @default(30)
  requirePriorDeductionAfterFirst Boolean            @default(true)
  overLimitAction                 OverLimitAction    @default(REJECT)
  overDurationAction              OverDurationAction @default(REJECT)
  approvalThresholdKobo           Int?
  requireApprovalFirstPurchase    Boolean            @default(false)
  requireApprovalHighRisk         Boolean            @default(true)
  highRiskScoreThreshold          Int                @default(70)
  consecutiveMissesBeforeFreeze   Int                @default(3)
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt
}

model CreditAccount {
  id                         String              @id @default(cuid())
  employeeId                 String              @unique
  employee                   Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  creditLimitKobo            Int                 @default(0)
  manualLimitOverrideKobo    Int?
  principalOutstandingKobo   Int                 @default(0)
  postedInterestKobo         Int                 @default(0)
  postedFeesKobo             Int                 @default(0)
  postedPenaltiesKobo        Int                 @default(0)
  reservedKobo               Int                 @default(0)
  accruedInterestUnpostedKobo Int                @default(0)
  availableKobo              Int                 @default(0)
  version                    Int                 @default(0)
  status                     CreditAccountStatus @default(ACTIVE)
  consecutiveMissedDeductions Int                @default(0)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  ledgerEntries    LedgerEntry[]
  reservations     CreditReservation[]
  interestDays     InterestAccrualDay[]
  writeOffRequests WriteOffRequest[]

  @@index([status])
}

model LedgerEntry {
  id              String          @id @default(cuid())
  creditAccountId String
  creditAccount   CreditAccount   @relation(fields: [creditAccountId], references: [id])
  sequence        Int
  entryType       LedgerEntryType
  /// Positive = increases amount owed / reserved; negative = decreases (repayment, release, refund).
  amountKobo      Int
  /// Snapshot of total posted owed (principal+interest+fees+penalties) after this entry.
  balanceAfterKobo Int
  reservedAfterKobo Int           @default(0)
  productType     ProductType?
  referenceType   String?
  referenceId     String?
  idempotencyKey  String?
  metadata        Json            @default("{}")
  createdByUserId String?
  createdBy       User?           @relation("LedgerCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime        @default(now())

  @@unique([creditAccountId, sequence])
  @@unique([creditAccountId, idempotencyKey])
  @@index([creditAccountId, createdAt])
  @@index([referenceType, referenceId])
  @@index([entryType, createdAt])
}

model CreditReservation {
  id                    String                  @id @default(cuid())
  creditAccountId       String
  creditAccount         CreditAccount           @relation(fields: [creditAccountId], references: [id])
  orderId               String                  @unique
  order                 Order                   @relation(fields: [orderId], references: [id])
  amountKobo            Int
  capturedKobo          Int                     @default(0)
  releasedKobo          Int                     @default(0)
  status                CreditReservationStatus @default(ACTIVE)
  expiresAt             DateTime
  createdLedgerEntryId  String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([creditAccountId, status])
  @@index([status, expiresAt])
}

model InterestAccrualDay {
  id                String        @id @default(cuid())
  creditAccountId   String
  creditAccount     CreditAccount @relation(fields: [creditAccountId], references: [id])
  accrualDate       DateTime      @db.Date
  outstandingBaseKobo Int
  accrualKobo       Int
  posted            Boolean       @default(false)
  createdAt         DateTime      @default(now())

  @@unique([creditAccountId, accrualDate])
  @@index([posted, accrualDate])
}

model WriteOffRequest {
  id              String         @id @default(cuid())
  creditAccountId String
  creditAccount   CreditAccount  @relation(fields: [creditAccountId], references: [id])
  amountKobo      Int
  reason          String
  status          WriteOffStatus @default(PENDING)
  requestedById   String
  requestedBy     User           @relation("WriteOffRequester", fields: [requestedById], references: [id])
  approvedById    String?
  approvedBy      User?          @relation("WriteOffApprover", fields: [approvedById], references: [id])
  ledgerEntryId   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, createdAt])
}

model PlatformSettings {
  id                       String   @id @default("default")
  maxInterestAnnualRateBps Int      @default(2400)
  penaltiesEnabledGlobal   Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// ORDERS
// ═══════════════════════════════════════════════════════════════

model Order {
  id                  String                 @id @default(cuid())
  employeeId          String
  employee            Employee               @relation(fields: [employeeId], references: [id])
  employerId          String
  employer            Employer               @relation(fields: [employerId], references: [id])
  pickupPointId       String
  pickupPoint         EmployerPickupPoint    @relation(fields: [pickupPointId], references: [id])
  productType         ProductType            @default(FOOD)
  subtotalKobo        Int
  deliveryFeeKobo     Int
  serviceFeeKobo      Int                    @default(0)
  totalKobo           Int
  fulfillmentStatus   OrderFulfillmentStatus @default(DRAFT)
  creditStatus        OrderCreditStatus      @default(NONE)
  approvalExpiresAt   DateTime?
  approvedAmountKobo  Int?
  graceInterestStartsAt DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  items          OrderItem[]
  reservation    CreditReservation?
  /// Legacy read-only after revolving credit cutover.
  deductionPlan  PayrollDeductionPlan?
  statusHistory  OrderStatusHistory[]

  @@index([employeeId, employerId])
  @@index([employeeId, fulfillmentStatus, createdAt])
  @@index([employerId, fulfillmentStatus])
  @@index([pickupPointId])
  @@index([creditStatus, fulfillmentStatus])
}

model OrderStatusHistory {
  id        String                 @id @default(cuid())
  orderId   String
  order     Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderFulfillmentStatus?
  toStatus  OrderFulfillmentStatus
  note      String?
  changedById String?
  changedBy User?                  @relation("OrderStatusActor", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt DateTime               @default(now())

  @@index([orderId, createdAt])
  @@index([toStatus, createdAt])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  packId            String?
  name              String
  brand             String   @default("")
  packageLabel      String   @default("")
  quantity          Int
  fulfilledQuantity Int      @default(0)
  unitPriceKobo     Int
  lineTotalKobo     Int
  createdAt         DateTime @default(now())

  @@index([orderId])
  @@index([packId])
}

/// Legacy per-order installment plan  retained read-only; no new rows after cutover.
model PayrollDeductionPlan {
  id            String                        @id @default(cuid())
  orderId       String                        @unique
  order         Order                         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  intervalCount Int
  status        DeductionStatus               @default(ACTIVE)
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
  installments  PayrollDeductionInstallment[]
}

model PayrollDeductionInstallment {
  id         String            @id @default(cuid())
  planId     String
  plan       PayrollDeductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  sequence   Int
  amountKobo Int
  dueDate    DateTime
  status     InstallmentStatus @default(SCHEDULED)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([planId, sequence])
  @@index([status, dueDate])
}

// ═══════════════════════════════════════════════════════════════
// PAYROLL
// ═══════════════════════════════════════════════════════════════

model PayrollRun {
  id             String           @id @default(cuid())
  employerId     String
  employer       Employer         @relation(fields: [employerId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  payrollDate    DateTime
  status         PayrollRunStatus @default(DRAFT)
  idempotencyKey String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  lines          PayrollDeductionLine[]

  @@unique([employerId, idempotencyKey])
  @@index([employerId, status])
  @@index([employerId, payrollDate])
}

model PayrollDeductionLine {
  id                       String                     @id @default(cuid())
  payrollRunId             String
  payrollRun               PayrollRun                 @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId               String
  employee                 Employee                   @relation(fields: [employeeId], references: [id])
  salarySnapshotKobo       Int
  deductionPercentSnapshot Int
  requestedKobo            Int
  collectedKobo            Int                        @default(0)
  status                   PayrollDeductionLineStatus @default(PENDING)
  ledgerEntryId            String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@unique([payrollRunId, employeeId])
  @@index([employeeId, status])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════
// RISK / AUDIT / OUTBOX / NOTIFICATIONS / IDEMPOTENCY
// ═══════════════════════════════════════════════════════════════

model RiskProfile {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  score      Int      @default(50)
  factors    Json     @default("{}")
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model OutboxEvent {
  id          String            @id @default(cuid())
  type        String
  payload     Json
  status      OutboxEventStatus @default(PENDING)
  attempts    Int               @default(0)
  lastError   String?
  createdAt   DateTime          @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
}

model Notification {
  id        String                     @id @default(cuid())
  userId    String
  user      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  channel   NotificationChannel        @default(IN_APP)
  status    NotificationDeliveryStatus @default(PENDING)
  payload   Json                       @default("{}")
  readAt    DateTime?
  createdAt DateTime                   @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model IdempotencyRecord {
  id           String   @id @default(cuid())
  actorId      String
  actor        User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action       String
  key          String
  requestHash  String
  responseJson Json?
  responseCode Int?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([actorId, action, key])
  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════════
// MEASURES & SCALES
// ═══════════════════════════════════════════════════════════════

model MeasureFamily {
  id                    String               @id @default(cuid())
  slug                  String               @unique
  name                  String
  description           String               @default("")
  dimension             MeasureDimension
  defaultRecipeUnitId   String?
  defaultRecipeUnit     MeasureUnit?         @relation("FamilyDefaultRecipe", fields: [defaultRecipeUnitId], references: [id], onDelete: SetNull)
  defaultPurchaseUnitId String?
  defaultPurchaseUnit   MeasureUnit?         @relation("FamilyDefaultPurchase", fields: [defaultPurchaseUnitId], references: [id], onDelete: SetNull)
  sortOrder             Int                  @default(0)
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  products              MarketplaceProduct[]

  @@index([isActive, sortOrder])
}

model MeasureUnit {
  id             String            @id @default(cuid())
  slug           String            @unique
  name           String
  shortLabel     String
  kind           MeasureKind
  dimension      MeasureDimension
  milligrams     Int?
  millilitres    Int?
  piecesPerUnit  Int?
  isPurchaseUnit Boolean           @default(false)
  isRecipeUnit   Boolean           @default(false)
  sortOrder      Int               @default(0)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  familiesAsRecipe   MeasureFamily[]      @relation("FamilyDefaultRecipe")
  familiesAsPurchase MeasureFamily[]      @relation("FamilyDefaultPurchase")
  productsAsRecipe   MarketplaceProduct[] @relation("ProductRecipeUnit")
  packs              ProductPack[]
  mealPlanItems      MealPlanItem[]
  recipeIngredients  RecipeIngredient[]

  @@index([isActive, sortOrder])
  @@index([dimension, isRecipeUnit])
  @@index([dimension, isPurchaseUnit])
}

// ═══════════════════════════════════════════════════════════════
// MARKETPLACE
// ═══════════════════════════════════════════════════════════════

model MarketplaceCategory {
  id            String                   @id @default(cuid())
  slug          String                   @unique
  name          String
  imageUrl      String
  accentColor   String
  sortOrder     Int                      @default(0)
  isActive      Boolean                  @default(true)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  subcategories MarketplaceSubcategory[]
  products      MarketplaceProduct[]

  @@index([isActive, sortOrder])
}

model MarketplaceSubcategory {
  id         String               @id @default(cuid())
  slug       String
  categoryId String
  category   MarketplaceCategory  @relation(fields: [categoryId], references: [id])
  name       String
  sortOrder  Int                  @default(0)
  isActive   Boolean              @default(true)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  products   MarketplaceProduct[]

  @@unique([categoryId, slug])
  @@index([categoryId, isActive, sortOrder])
}

model MarketplaceProduct {
  id                           String                 @id @default(cuid())
  slug                         String                 @unique
  categoryId                   String
  category                     MarketplaceCategory    @relation(fields: [categoryId], references: [id])
  subcategoryId                String
  subcategory                  MarketplaceSubcategory @relation(fields: [subcategoryId], references: [id])
  measureFamilyId              String
  measureFamily                MeasureFamily          @relation(fields: [measureFamilyId], references: [id])
  recipeUnitId                 String?
  recipeUnit                   MeasureUnit?           @relation("ProductRecipeUnit", fields: [recipeUnitId], references: [id], onDelete: SetNull)
  name                         String
  imageUrl                     String
  description                  String                 @default("")
  origin                       String                 @default("")
  recipeUnitOverrideMg         Int?
  recipeUnitOverrideMl         Int?
  expiresAt                    DateTime?
  isVerified                   Boolean                @default(false)
  bulkAllocationClaimedPercent Int                    @default(0)
  nutritionFacts               Json                   @default("{}")
  perfectFor                   Json                   @default("[]")
  tags                         String[]               @default([])
  sortOrder                    Int                    @default(0)
  isActive                     Boolean                @default(true)
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  packs                        ProductPack[]
  reviews                      ProductReview[]
  wishlistItems                WishlistItem[]
  productAllergens             ProductAllergen[]
  mealPlanItems                MealPlanItem[]
  householdStock               HouseholdStock[]
  recipeIngredients            RecipeIngredient[]

  @@index([categoryId, isActive])
  @@index([subcategoryId, isActive])
  @@index([measureFamilyId])
  @@index([recipeUnitId])
  @@index([isActive, sortOrder])
}

model ProductPack {
  id              String             @id @default(cuid())
  sku             String             @unique
  productId       String
  product         MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  packUnitId      String
  packUnit        MeasureUnit        @relation(fields: [packUnitId], references: [id])
  brand           String
  packAmount      Int
  amountMg        Int?
  amountMl        Int?
  amountEach      Int?
  packageLabel    String
  imageUrl        String
  priceKobo       Int
  retailPriceKobo Int
  sortOrder       Int                @default(0)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  cartItems       CartItem[]
  packageItems    PackageItem[]

  @@unique([productId, brand, packageLabel])
  @@index([productId, isActive, sortOrder])
  @@index([isActive, sortOrder])
}

model WishlistItem {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String
  product         MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceKoboAtSave Int
  createdAt       DateTime           @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model ProductReview {
  id           String                 @id @default(cuid())
  productId    String
  product      MarketplaceProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating       Int
  body         String
  helpfulCount Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  helpfulVotes ProductReviewHelpful[]

  @@unique([productId, userId])
  @@index([productId, createdAt])
  @@index([productId, helpfulCount])
}

model ProductReviewHelpful {
  reviewId  String
  userId    String
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([reviewId, userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id            String      @id @default(cuid())
  cartId        String
  cart          Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  packId        String
  pack          ProductPack @relation(fields: [packId], references: [id])
  quantity      Int         @default(1)
  unitPriceKobo Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([cartId, packId])
  @@index([cartId])
  @@index([packId])
}

model MarketplaceBanner {
  id            String   @id @default(cuid())
  badgeLabel    String
  title         String
  subtitle      String
  ctaLabel      String
  ctaRoute      String?
  gradientStart String
  gradientEnd   String
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model PantryPackage {
  id              String                 @id @default(cuid())
  kind            PackageKind
  name            String
  description     String                 @default("")
  coverImageUrl   String
  isPopular       Boolean                @default(false)
  sortOrder       Int                    @default(0)
  isActive        Boolean                @default(true)
  visibility      PackageVisibility      @default(PRIVATE)
  shareSlug       String                 @unique
  createdByUserId String?
  createdBy       User?                  @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  items           PackageItem[]
  subscriptions   PackageSubscription[]
  mealPlan        MealPlan?

  @@index([kind, isActive, sortOrder])
  @@index([visibility, kind])
  @@index([createdByUserId])
}

model PackageItem {
  id        String        @id @default(cuid())
  packageId String
  package   PantryPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packId    String
  pack      ProductPack   @relation(fields: [packId], references: [id])
  quantity  Int           @default(1)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([packageId, packId])
  @@index([packageId, sortOrder])
  @@index([packId])
}

model PackageDiscountTier {
  id              String   @id @default(cuid())
  label           String
  minSpendKobo    Int
  discountPercent Int
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, minSpendKobo])
}

model PlatformDeliverySettings {
  id                  String   @id @default("default")
  freeDeliveryMinKobo Int
  deliveryFeeKobo     Int
  updatedAt           DateTime @updatedAt
}

model PackageSubscription {
  id        String                    @id @default(cuid())
  userId    String
  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   PantryPackage             @relation(fields: [packageId], references: [id])
  status    PackageSubscriptionStatus @default(PENDING)
  snapshot  Json
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([userId, status])
  @@index([packageId, status])
}

// ═══════════════════════════════════════════════════════════════
// NUTRITION & AI MEAL PLANS
// ═══════════════════════════════════════════════════════════════

model Allergy {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileLinks     HealthProfileAllergy[]
  productAllergens ProductAllergen[]

  @@index([isActive, sortOrder])
}

model PrimaryGoal {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  iconKey     String   @default("flag")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profileLinks HealthProfileGoal[]

  @@index([isActive, sortOrder])
}

model HealthProfile {
  id            String           @id @default(cuid())
  employeeId    String           @unique
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  age           Int
  gender        String
  heightCm      Int
  weightKg      Int
  lifestyle     DietaryLifestyle @default(EVERYTHING)
  activityLevel ActivityLevel    @default(MODERATE)
  householdSize Int              @default(1)
  hasChildren   Boolean          @default(false)
  targetEnergyKcal Int           @default(0)
  targetProteinMg  Int           @default(0)
  targetCarbsMg    Int           @default(0)
  targetFatMg      Int           @default(0)
  targetFiberMg    Int           @default(0)
  targetSugarMg    Int           @default(0)
  targetSodiumMg   Int           @default(0)
  targetIronUg     Int           @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  allergies HealthProfileAllergy[]
  goals     HealthProfileGoal[]
}

model HealthProfileAllergy {
  id              String        @id @default(cuid())
  healthProfileId String
  healthProfile   HealthProfile @relation(fields: [healthProfileId], references: [id], onDelete: Cascade)
  allergyId       String?
  allergy         Allergy?      @relation(fields: [allergyId], references: [id], onDelete: SetNull)
  customLabel     String?
  createdAt       DateTime      @default(now())

  @@index([healthProfileId])
  @@index([allergyId])
}

model HealthProfileGoal {
  id              String        @id @default(cuid())
  healthProfileId String
  healthProfile   HealthProfile @relation(fields: [healthProfileId], references: [id], onDelete: Cascade)
  goalId          String?
  goal            PrimaryGoal?  @relation(fields: [goalId], references: [id], onDelete: SetNull)
  customLabel     String?
  createdAt       DateTime      @default(now())

  @@index([healthProfileId])
  @@index([goalId])
}

model ProductAllergen {
  id        String             @id @default(cuid())
  productId String
  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  allergyId String
  allergy   Allergy            @relation(fields: [allergyId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@unique([productId, allergyId])
  @@index([allergyId])
  @@index([productId])
}

model MealPlan {
  id             String         @id @default(cuid())
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status         MealPlanStatus @default(GENERATING)
  source         MealPlanSource @default(AI)
  title          String         @default("Personalized Meal Plan")
  startsOn       DateTime?      @db.Date
  endsOn         DateTime?      @db.Date
  promptSnapshot Json           @default("{}")
  rawAiResponse  Json           @default("{}")
  failureReason  String?
  adminNote      String?
  createdById    String?
  createdBy      User?          @relation("MealPlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById   String?
  reviewedBy     User?          @relation("MealPlanReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  activatedAt    DateTime?
  packageId      String?        @unique
  package        PantryPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  days MealPlanDay[]

  @@index([employeeId, status])
  @@index([status, createdAt])
  @@index([createdById])
}

model MealPlanDay {
  id         String    @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan  @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  dayIndex   Int
  label      String    @default("")
  /// Calendar date for this plan day (timezone-agnostic date).
  planDate   DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items MealPlanItem[]

  @@unique([mealPlanId, dayIndex])
  @@index([mealPlanId])
  @@index([planDate])
}

model MealPlanItem {
  id                   String              @id @default(cuid())
  mealPlanDayId        String
  mealPlanDay          MealPlanDay         @relation(fields: [mealPlanDayId], references: [id], onDelete: Cascade)
  mealSlot             String
  title                String
  rationale            String              @default("")
  requestedProductName String              @default("")
  productId            String?
  product              MarketplaceProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  measureUnitId        String?
  measureUnit          MeasureUnit?        @relation(fields: [measureUnitId], references: [id], onDelete: SetNull)
  matchType            MealItemMatchType   @default(PRIMARY)
  quantity             Int                 @default(1)
  quantityCanonical    Int                 @default(0)
  recipeId             String?
  recipe               Recipe?             @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  sortOrder            Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  cookedMeals CookedMeal[]

  @@index([mealPlanDayId, sortOrder])
  @@index([productId])
  @@index([measureUnitId])
  @@index([recipeId])
}

// ═══════════════════════════════════════════════════════════════
// HOUSEHOLD STOCK & COOKED NUTRITION
// ═══════════════════════════════════════════════════════════════

model HouseholdStock {
  id                        String   @id @default(cuid())
  employeeId                String
  employee                  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  productId                 String
  product                   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityCanonical         Int      @default(0)
  restockThresholdCanonical Int      @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  ledger HouseholdStockLedger[]
  alerts RestockAlert[]

  @@unique([employeeId, productId])
  @@index([employeeId])
  @@index([productId])
}

model HouseholdStockLedger {
  id             String                     @id @default(cuid())
  stockId        String
  stock          HouseholdStock             @relation(fields: [stockId], references: [id], onDelete: Cascade)
  reason         HouseholdStockLedgerReason
  deltaCanonical Int
  orderId        String?
  cookedMealId   String?
  note           String?
  createdAt      DateTime                   @default(now())

  @@index([stockId, createdAt])
  @@index([orderId])
  @@index([cookedMealId])
}

model RestockAlert {
  id         String             @id @default(cuid())
  employeeId String
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  stockId    String
  stock      HouseholdStock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  productId  String
  status     RestockAlertStatus @default(OPEN)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  resolvedAt DateTime?

  @@index([employeeId, status])
  @@index([stockId, status])
  @@index([productId])
}

model Recipe {
  id               String       @id @default(cuid())
  employeeId       String
  employee         Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title            String
  mealSlot         String
  instructions     String       @default("")
  instructionSteps String[]     @default([])
  rationale        String       @default("")
  source           RecipeSource @default(AI)
  goalSnapshot     Json         @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  ingredients   RecipeIngredient[]
  mealPlanItems MealPlanItem[]
  cookedMeals   CookedMeal[]

  @@index([employeeId, createdAt])
}

model RecipeIngredient {
  id                String             @id @default(cuid())
  recipeId          String
  recipe            Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId         String
  product           MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  measureUnitId     String?
  measureUnit       MeasureUnit?       @relation(fields: [measureUnitId], references: [id], onDelete: SetNull)
  quantity          Int                @default(1)
  quantityCanonical Int
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())

  @@index([recipeId, sortOrder])
  @@index([productId])
  @@index([measureUnitId])
}

model CookedMeal {
  id             String         @id @default(cuid())
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  recipeId       String
  recipe         Recipe         @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  mealPlanItemId String?        @unique
  mealPlanItem   MealPlanItem?  @relation(fields: [mealPlanItemId], references: [id], onDelete: SetNull)
  cookedAt       DateTime       @default(now())
  energyKcal     Int            @default(0)
  proteinMg      Int            @default(0)
  carbsMg        Int            @default(0)
  fatMg          Int            @default(0)
  fiberMg        Int            @default(0)
  sugarMg        Int            @default(0)
  sodiumMg       Int            @default(0)
  ironUg         Int            @default(0)
  createdAt      DateTime       @default(now())

  @@index([employeeId, cookedAt])
  @@index([recipeId])
  @@index([mealPlanItemId])
}

model DailyNutritionLog {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  day        DateTime @db.Date
  energyKcal Int      @default(0)
  proteinMg  Int      @default(0)
  carbsMg    Int      @default(0)
  fatMg      Int      @default(0)
  fiberMg    Int      @default(0)
  sugarMg    Int      @default(0)
  sodiumMg   Int      @default(0)
  ironUg     Int      @default(0)
  cookedCount Int     @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, day])
  @@index([employeeId, day])
}

// ═══════════════════════════════════════════════════════════════
// COMPANY MONTHLY INVOICES
// ═══════════════════════════════════════════════════════════════

model CompanyInvoice {
  id              String               @id @default(cuid())
  employerId      String
  employer        Employer             @relation(fields: [employerId], references: [id], onDelete: Cascade)
  periodStart     DateTime             @db.Date
  periodEnd       DateTime             @db.Date
  status          CompanyInvoiceStatus @default(DRAFT)
  subtotalKobo    Int                  @default(0)
  feesKobo        Int                  @default(0)
  interestKobo    Int                  @default(0)
  totalDueKobo    Int                  @default(0)
  remittedKobo    Int                  @default(0)
  generatedById   String?
  generatedBy     User?                @relation("InvoiceGenerator", fields: [generatedById], references: [id], onDelete: SetNull)
  issuedAt        DateTime?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  lines CompanyInvoiceLine[]

  @@unique([employerId, periodStart, periodEnd])
  @@index([employerId, status])
  @@index([periodEnd])
}

model CompanyInvoiceLine {
  id              String         @id @default(cuid())
  invoiceId       String
  invoice         CompanyInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  employeeId      String?
  employee        Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  description     String
  orderId         String?
  amountKobo      Int
  category        String         @default("PURCHASE")
  createdAt       DateTime       @default(now())

  @@index([invoiceId])
  @@index([employeeId])
}

// ═══════════════════════════════════════════════════════════════
// BLOG / JOURNAL
// ═══════════════════════════════════════════════════════════════

model BlogPost {
  id              String           @id @default(cuid())
  slug            String           @unique
  title           String
  excerpt         String
  category        BlogPostCategory
  bodyParagraphs  Json
  coverGradient   String
  coverImageUrl   String?
  youtubeUrl      String?
  tiktokUrl       String?
  readTimeMinutes Int              @default(1)
  status          BlogPostStatus   @default(DRAFT)
  publishedAt     DateTime?
  authorUserId    String?
  author          User?            @relation("BlogPostAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, publishedAt])
  @@index([category, status])
  @@index([authorUserId])
}
